{
  "name": "@owncontext/mcp-server",
  "version": "0.1.0",
  "private": true,
  "description": "Read-only local stdio MCP adapter for the OwnContext vault.",
  "type": "module",
  "bin": {
    "owncontext-mcp": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run tests",
    "test:protocol": "npm run build --workspace @owncontext/core && npm run build && vitest run tests/stdio.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@owncontext/core": "0.1.0",
    "zod": "^4.4.3"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
