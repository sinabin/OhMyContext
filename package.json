{
  "name": "owncontext",
  "version": "0.0.0",
  "private": true,
  "description": "A local-first personal context vault for MCP-compatible AI clients.",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "check": "npm run typecheck && npm test",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "@types/node": "^22.17.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
